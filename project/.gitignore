# ========================================
# Data Files (保留目录结构，忽略大文件)
# ========================================
# 原始数据文件（用户自行放置）
data/raw/*.txt
data/raw/*.csv
data/raw/*.dat

# 处理后的数据文件（脚本生成）
data/processed/*.parquet
data/processed/*.json
data/processed/*.yaml
data/processed/manifest.*

# 不忽略 .gitkeep 文件（用于保留空目录）
!data/raw/.gitkeep
!data/processed/.gitkeep

